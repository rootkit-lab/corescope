# .clangd — IntelliSense para clangd LSP (Cursor/VSCode/Helix/etc.)
# Suporta tanto build native quanto cross-compile (mingw) — selecionado por compile_commands.json
# ou por flags explícitas abaixo (fallback quando não há compile_commands).

CompileFlags:
  CompilationDatabase: build/
  Add:
    - -std=c11
    - -Wall
    - -Wextra
    - -Iinclude

# Quando não há compile_commands.json, clangd infere flags por arquivo:
If:
  PathMatch: src/transport/transport_tls.c
  CompileFlags:
    Add:
      - -DWINDOWS_TLS=1
      - -Ithird_party/openssl-mingw/prefix/include

If:
  PathMatch: src/transport/transport_tls_stub.c
  CompileFlags:
    Add:
      - -DNO_TLS_STUB

If:
  PathMatch: src/.*_win\.c
  CompileFlags:
    Add:
      - --target=x86_64-w64-mingw32
      - -D_WIN32_WINNT=0x0601

Diagnostics:
  ClangTidy:
    Add: [bugprone-*, performance-*, portability-*, readability-*]
    Remove: [readability-magic-numbers, readability-identifier-length]
  UnusedIncludes: Strict

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes
